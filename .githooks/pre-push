#!/bin/sh

# Hook pre-push: Bloquea push directo a main o master a menos que sea aprobado por Jenkins
if [ "$JENKINS_GATEKEEPER_APPROVED" = "true" ]; then
    exit 0
fi

while read local_ref local_sha remote_ref remote_sha
do
    case "$remote_ref" in
        refs/heads/main|refs/heads/master)
            echo ""
            echo "🛑 ============================================================"
            echo "⛔ ACCESO DENEGADO A RAMA PROTEGIDA ($remote_ref)"
            echo "============================================================"
            echo "👉 En este taller, la rama de producción está blindada."
            echo "👉 No se permite hacer push directo a main sin pasar por Jenkins."
            echo ""
            echo "🚀 Para auditar tu código y desplegarlo de forma segura:"
            echo "   npm run jenkins"
            echo "============================================================"
            echo ""
            exit 1
            ;;
    esac
done

exit 0
